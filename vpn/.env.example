# Common backend configuration: ../shared/README.md
# WireGuard VPN Controller Environment Configuration
PORT=3004
NODE_ENV=development

# Database Configuration (memory or postgres)
DB_DRIVER=memory
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=securecam_db
DB_SSL=false
DB_SSL_CA_FILE=

# JWT Secret for Auth Middleware
JWT_SECRET=replace-with-a-long-random-jwt-secret-before-deployment

# WireGuard Server Configuration (ICD-06 5.1)
WG_INTERFACE=wg0
WG_PORT=443
WG_SERVER_ENDPOINT=vpn.securecam.com:443
WG_SERVER_IP=10.0.0.1
WG_SUBNET=10.0.0.0/24
WG_MTU=1420
WG_KEEPALIVE=25
WG_SERVER_PUBLIC_KEY=mQZq8v6eX2o9A1t8y4U5i6o7P8q9R0s1T2u3V4w5X6Y=
WG_SERVER_PRIVATE_KEY=4A7b8C9d0E1f2G3h4I5j6K7l8M9n0O1p2Q3r4S5t6U8=
WG_CONFIG_PATH=/etc/wireguard/wg0.conf

# Driver mode: 'virtual' (in-memory simulation) or 'linux' (system wg CLI)
WG_DRIVER=virtual

# IP Pool Configuration (ICD-06 5.1: 10.0.0.10 ~ 10.0.0.250)
IP_POOL_START=10.0.0.10
IP_POOL_END=10.0.0.250
