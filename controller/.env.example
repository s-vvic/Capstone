# Master Controller Server Configuration
PORT=3000
NODE_ENV=development
API_BASE_URL=https://api.securecam.com/v1

# Common JWT Secret for Inter-Component Auth (ICD-01, NF-S-003)
JWT_SECRET=securecam-cloud-super-secret-jwt-key-2026-v1.0

# Database Configuration (PostgreSQL 17.X or Memory)
DB_DRIVER=memory
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=securecam_db
DB_SSL=false

# Component 2 WireGuard & Media Configuration
WG_SERVER_PUBKEY=BM8aXkG2HwW9QZ3y4j6kLmN1PqRsTuVwXyZ01234567=
WG_SERVER_ENDPOINT=vpn.securecam.com:443
MEDIAMTX_RTSP_PROXY_IP=10.0.0.1
RTSP_PORT=8554

# Component 3 FCM Configuration
FCM_SERVER_KEY=mock-fcm-server-key-2026
FCM_PROJECT_ID=securecam-fcm-project

# Component 5 Storage Configuration
STORAGE_ROOT=./storage-data
