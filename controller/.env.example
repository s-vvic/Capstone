# 통합 controller: C1/C2/C3/C4/C5. controller/에서 .env로 복사하고 npm start 실행.
# node --env-file=.env 사용. 하위 컴포넌트 .env를 자동 병합하지 않는다.
# 프로세스에 이미 설정된 환경변수(PM2/systemd 등)는 .env보다 우선한다.
# 아래는 로컬 개발 예시다. 운영 주소·비밀번호·키는 실제 값으로 교체한다.
# C7은 MEDIAMTX_ENABLED=true일 때 이 .env로 설정 생성·실행·종료를 함께 관리한다.

# 공통 서버
PORT=3000
NODE_ENV=development
API_BASE_URL=http://10.0.0.100:3000/v1

# C1 인증: 전체 컴포넌트 공통 비밀키. 운영 시 충분히 긴 난수로 교체한다.
# JWT_SECRET을 바꾸면 기존 로그인 토큰은 무효화된다.
JWT_SECRET=replace-with-a-long-random-jwt-secret-before-deployment
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=365d
JWT_NORMAL_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15

# 공통 DB 선택: memory(개발용 임시 저장소) / postgres(PostgreSQL 17)
DB_DRIVER=memory
# C1/C2/C3/C4/C5가 모두 아래 접속 정보를 사용한다.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=securecam_db
DB_SSL=false
# 모든 DB 클라이언트는 DB_SSL=true일 때 인증서를 검증한다.
# 사설 CA는 DB_SSL_CA_FILE에 지정한다. 비어 있으면 시스템 신뢰 CA 사용.
DB_SSL_CA_FILE=

# 이전 DATABASE_URL은 DB_* 접속 항목이 모두 없을 때만 호환용으로 사용한다.
# VPN용 DB 주소를 중복 작성하지 않고 위 DB_*만 설정한다.

# C2 device-heartbeat: 정상 접근 로그만 끄며 오류 로그는 계속 출력한다.
C2_ACCESS_LOG_ENABLED=false
OFFLINE_CHECK_INTERVAL_SECONDS=1
# 보드 rkipc RTSP 포트. MediaMTX 출력 포트가 아니다.
RTSP_PORT=554
WEBRTC_BASE_URL=http://10.0.0.100:8889
CLIENT_VPN_SUBNET=10.0.2.0/24
HTTPS_PROXY_ENABLED=false
BOARD_VPN_SUBNET=10.0.1.0/24
# heartbeat 5초 / offline 15초는 현재 코드 상수로 .env 변경 불가.

# C4 vpn: virtual은 가상 드라이버, linux는 실제 wg CLI 사용.
# 실제 서버는 linux + 실제 인터페이스명/설정 파일 + wg 실행 권한 필요.
# Linux 외 OS에서는 linux를 지정해도 현재 구현상 가상 드라이버로 동작한다.
WG_DRIVER=virtual
WG_INTERFACE=wg0
WG_CONFIG_PATH=/etc/wireguard/wg0.conf
# 공인 IP/도메인:실제 WireGuard UDP 포트. http(s)://는 붙이지 않는다.
# 기존 C4 기본값은 443. 실제 ListenPort 및 ICD_v2의 51820(TBR)과 맞춰 조정한다.
WG_SERVER_ENDPOINT=vpn.securecam.com:443
WG_PORT=443
WG_SERVER_IP=10.0.0.100
WG_KEEPALIVE=25
# 실제 서버 키를 입력한다. 빈 값은 현재 코드의 더미 키로 대체되므로 운영에서는 필수.
# 현재 C4 변수명은 WG_SERVER_PUBKEY가 아니라 WG_SERVER_PUBLIC_KEY다.
WG_SERVER_PUBLIC_KEY=
WG_SERVER_PRIVATE_KEY=

# 아래 4개는 설정 객체에 있으나 현재 실제 동작에 연결되지 않은 변수다.
# WG_SUBNET: 생성 클라이언트 AllowedIPs는 이 값 대신 코드 상수 사용.
# WG_MTU: 생성 WireGuard 설정에 미반영.
# IP_POOL_START/END: 기본 IpPoolManager에 전달되지 않아 실제 할당 범위 변경 불가.
# 현재 실제 기본 풀은 10.0.0.10~10.0.0.250. 보드/폰 대역 분리는 코드 보완 필요.
WG_SUBNET=10.0.0.0/24
WG_MTU=1420
IP_POOL_START=10.0.0.10
IP_POOL_END=10.0.0.250

# C3: 현재 FCM 송신은 시뮬레이션. 키 입력만으로 실제 Push가 활성화되지는 않는다.
FCM_SERVER_KEY=mock-fcm-server-key-2026
FCM_PROJECT_ID=securecam-fcm-project
FCM_MOCK_DELAY_MS=50
# 상대 파일 경로는 controller 실행 디렉터리 기준.
SNAPSHOT_UPLOAD_DIR=./uploads/snapshots
# SNAPSHOT_BASE_URL은 선택 항목. 생략하면 API_BASE_URL + /snapshots 사용.

# C5 저장소 / 파일 다운로드 / 공유
STORAGE_ROOT=./storage-data
# 다운로드·공유 URL도 위 API_BASE_URL(/v1 포함)에서 만든다.
# 다운로드 서명에 필요. JWT_SECRET과 다른 난수로 교체한다.
SIGNED_URL_SECRET=replace-with-an-independent-random-download-signing-secret
SIGNED_URL_TTL_SEC=900
SHARE_DEFAULT_HOURS=24
SHARE_MAX_HOURS=168
RETENTION_BATCH_SIZE=500
# 현재 controller는 보존 스케줄러를 시작하지 않는다.
# 아래 항목은 startRetentionScheduler()를 실행하는 경로에서만 적용된다.
RETENTION_ENABLED=true
RETENTION_CRON="0 0 * * *"

# WG_SERVER_PUBKEY는 호환용이며 표준 변수는 WG_SERVER_PUBLIC_KEY다.
# MEDIAMTX_RTSP_PROXY_IP는 현재 코드에서 읽지 않아 예제에서 제거했다.
# /health 및 /v1/vpn/status의 healthy는 DB 연결 성공을 보증하지 않는다.
# DB 변경 후 로그인 상태에서 GET /v1/vpn/connections로 실제 DB 조회를 확인한다.

# C7 I2: 같은 호스트의 MediaMTX 바이너리를 controller가 자식 프로세스로 실행한다.
# 실제 설치 경로를 지정하고 true로 켠다. false면 기존 API만 실행한다.
MEDIAMTX_ENABLED=false
MEDIAMTX_BINARY=/usr/local/bin/mediamtx
# 생략 시 ../mediamtx/config/boards.json 및 ../mediamtx/runtime/mediamtx.yml 사용.
MEDIAMTX_BOARDS_FILE=
MEDIAMTX_CONFIG_PATH=
WEBRTC_ALLOWED_ORIGINS=*
MTX_ICE_UDP_PORT=8189
MTX_API_URL=http://127.0.0.1:9997
MTX_LOG_LEVEL=info
# HTTPS VPN proxy example: deploy/nginx-vpn-api.conf.example.
# Enable HTTPS_PROXY_ENABLED=true and set these only after DNS/certificate/Nginx setup:
# API_BASE_URL=https://api.example.com/v1
# WEBRTC_BASE_URL=https://api.example.com
# MTX_WEBRTC_PORT=8889
# NODE_EXTRA_CA_CERTS가 필요한 환경은 .env가 아닌 Node 시작 전 환경변수로 유지한다.
