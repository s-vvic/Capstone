# =============================================================================
# SecureCam Component 2: Device Registry & Heartbeat Module Configuration
# =============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development
API_BASE_URL=https://api.securecam.com/v1

# Database Configuration (PostgreSQL 17.X)
# Set DB_DRIVER=memory for standalone zero-setup testing, or DB_DRIVER=postgres for PostgreSQL 17.X
DB_DRIVER=memory
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=securecam_db
DB_SSL=false

# Authentication (JWT Secret matching Component 1)
JWT_SECRET=securecam-cloud-super-secret-jwt-key-2026-v1.0

# Heartbeat & Offline Monitoring Configuration (SV-F-011, SV-F-013, NF-P-003)
HEARTBEAT_INTERVAL_SECONDS=30
OFFLINE_TIMEOUT_SECONDS=60
OFFLINE_CHECK_INTERVAL_SECONDS=10

# WireGuard VPN & Network Provisioning Configuration (ICD 3.1.1, 5.1, NF-S-001)
WG_SERVER_PUBKEY=BM8aXkG2HwW9QZ3y4j6kLmN1PqRsTuVwXyZ01234567=
WG_SERVER_ENDPOINT=vpn.securecam.com:443
WG_SERVER_VPN_IP=10.0.0.1
WG_SUBNET=10.0.0.0/24
WG_IP_POOL_START=10.0.0.10
WG_IP_POOL_END=10.0.0.250

# Media Streaming Proxy Configuration (ICD 3.1.1, 4.1, 4.2)
MEDIAMTX_RTSP_PROXY_IP=10.0.0.1
RTSP_PORT=8554
