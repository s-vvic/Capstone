# C2: internal VPN HTTP service. Bind/firewall it within the VPN network.
PORT=3001
NODE_ENV=development
# Default: only request errors (4xx/5xx) and interrupted connections.
# Set true temporarily to print every incoming request and completed response.
C2_ACCESS_LOG_ENABLED=false
# memory is for isolated development; use postgres for persistent deployments.
DB_DRIVER=memory
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=securecam_db
DB_SSL=false
# When DB_SSL=true, optionally trust the database provider's CA PEM/bundle.
# Use an absolute path on the server running C2 or the integrated controller.
# DB_SSL_CA_FILE=/home/ubuntu/certs/database-ca.pem
# Must match C1. Required in production; use a strong deployment secret.
JWT_SECRET=replace-with-a-long-random-jwt-secret-before-deployment
# ICD heartbeat=5s and offline >15s are fixed; FR WC-F-031 conflict is documented.
OFFLINE_CHECK_INTERVAL_SECONDS=1
# ICD RTSP board source port [TBR]; not the WebRTC client URL.
RTSP_PORT=554
