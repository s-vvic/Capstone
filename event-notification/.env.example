# Server Configuration
NODE_ENV=development
PORT=3002
API_BASE_URL=https://api.securecam.com/v1

# Database Configuration (PostgreSQL 17.X - NF-F-001)
DB_DRIVER=memory
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=securecam_db
DB_SSL=false

# Authentication (NF-S-003)
JWT_SECRET=securecam-cloud-super-secret-jwt-key-2026-v1.0

# FCM Push Notification (ICD-07, NF-P-002)
FCM_SERVER_KEY=mock-fcm-server-key-2026
FCM_PROJECT_ID=securecam-fcm-project
FCM_MOCK_DELAY_MS=100

# Snapshot Storage Configuration
SNAPSHOT_UPLOAD_DIR=./uploads/snapshots
SNAPSHOT_BASE_URL=https://api.securecam.com/v1/snapshots
