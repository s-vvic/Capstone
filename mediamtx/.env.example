# Standalone C7 (do not run simultaneously with controller-managed MediaMTX).
# No DB, JWT or separate Node HTTP port is required in I2.
MEDIAMTX_ENABLED=true
MEDIAMTX_BINARY=mediamtx
# Relative paths are resolved from the execution directory; empty uses package defaults.
MEDIAMTX_BOARDS_FILE=
MEDIAMTX_CONFIG_PATH=
WG_SERVER_IP=10.0.0.100
BOARD_VPN_SUBNET=10.0.1.0/24
CLIENT_VPN_SUBNET=10.0.2.0/24
WEBRTC_BASE_URL=http://10.0.0.100:8889
WEBRTC_ALLOWED_ORIGINS=*
MTX_ICE_UDP_PORT=8189
MTX_API_URL=http://127.0.0.1:9997
MTX_LOG_LEVEL=info
RTSP_PORT=554
