# Common backend configuration: ../shared/README.md
# Node.js 24.11+. Copy to .env; configure and start use the SAME file.
C7_BIND_HOST=10.0.0.1
PORT=3007
API_BASE_URL=http://10.0.0.1:3007/v1
C7_ALLOWED_ORIGINS=http://localhost:5173,https://d1kp83poail7h2.cloudfront.net
# C1 /auth/me checks JWT signature, expiry AND active login session.
C7_AUTH_ME_URL=http://127.0.0.1:3000/v1/auth/me
C7_BOARD_CIDR=10.0.1.0/24
RTSP_PORT=554
C7_RTSP_HIGH_PATH=/live/0
C7_RTSP_LOW_PATH=/live/1
C7_RTSP_USERNAME=
C7_RTSP_PASSWORD=
C7_SESSION_TTL_SECONDS=3600
C7_MAX_SESSIONS=256
# Operational cap only: plan-specific limits remain unspecified in SPEC.
C7_MAX_READERS_PER_PATH=0
# Keep management and raw WHEP listeners on loopback. Never publish them.
MTX_API_URL=http://127.0.0.1:9997
MTX_WHEP_URL=http://127.0.0.1:8889
# Replace BOTH values with independent random secrets (at least 32 characters).
MTX_API_PASSWORD=
MTX_READ_PASSWORD=
WG_SERVER_IP=10.0.0.1
MTX_ICE_UDP_PORT=8189
MTX_LOG_LEVEL=warn
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=securecam_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
# For private database CAs, enable DB_SSL and supply the trusted CA file.
DB_SSL_CA_FILE=
