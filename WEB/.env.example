# Shared controller (C1 login and C4 VPN); default needs no overrides.
# API_PROXY_TARGET=http://localhost:3000
# Separate C4 process (npm start in ../vpn, port 3004):
# VPN_PROXY_TARGET=http://localhost:3004
# Direct deployment, including /v1 (requires server CORS and network access):
# VITE_API_BASE_URL=http://10.0.0.1:3000/v1
# VITE_VPN_API_BASE_URL=http://10.0.0.1:3004/v1
