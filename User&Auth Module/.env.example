# =============================================================================
# SecureCam Server Environment Variables
# =============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
API_BASE_URL=https://api.securecam.com/v1

# Database Configuration (PostgreSQL 17.X)
# Set DB_DRIVER=memory to run in standalone mock/in-memory mode for rapid testing,
# or DB_DRIVER=postgres to use real PostgreSQL 17.X
DB_DRIVER=memory
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=securecam_db
DB_SSL=false

# JWT Security Configuration (NF-S-003, ICD 1.3)
JWT_SECRET=securecam-cloud-super-secret-jwt-key-2026-v1.0
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=365d # 1 year (525,600 minutes) per ICD 1.3
JWT_NORMAL_EXPIRES_IN=1d # Standard non-auto-login session expiry (optional)

# Password Security (NF-S-002: bcrypt salt rounds >= 10)
BCRYPT_SALT_ROUNDS=12

# Rate Limiting & Brute-Force Protection (ICD 2.1.1 429 TOO_MANY_REQUESTS, NF-S-005)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15
